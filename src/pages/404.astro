---
import { Page } from '@/layouts'
import { Icon } from '@/components'
import { staticPages } from '@/data/pages'

const meta = staticPages['404']
---

<Page
    title={meta.title}
    description={meta.description}
    keywords={meta.keywords}
    image={`/og/${meta.slug}.png`}
    type='website'
    noindex
>
    <div class='flex flex-col items-center pt-[calc(50vh-10.5rem)] text-center'>
        <h1 class='text-3xl font-bold'>Page Not Found</h1>

        <p class='mt-3 text-soft'>
            The page you're looking for doesn't exist<br />
            or has been moved.
        </p>

        <a
            href='/'
            class='transition-hover mt-8 inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary-hover'
        >
            <Icon name='arrowLeft' class='h-4 w-4' />
            <span>Back to Home</span>
        </a>
    </div>
</Page>