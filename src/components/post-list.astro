---
import type { Post } from '@/types'
import { List, PostItem } from '@/components'

interface Props {
    items: Post[]
}

const { items } = Astro.props
---

<section class='mt-6' data-reveal>
    <List class='mt-3' data-reveal-group>
        {
            items.map((post) => (
                <PostItem
                    slug={post.slug}
                    title={post.data.title}
                    description={post.data.description}
                    date={post.data.date}
                />
            ))
        }
    </List>
</section>