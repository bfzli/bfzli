---
import type { Experience } from '@/types'
import { initials } from '@/utils/text'

const job = Astro.props as Experience
---

<div class='flex gap-4'>
    <div
        class='flex h-10 w-10 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl text-xs font-semibold text-comment'
    >
        {
            job.logo ? (
                <img
                    src={job.logo.src}
                    alt={job.company}
                    width={40}
                    height={40}
                    loading='eager'
                    data-skeleton
                    class='h-full w-full object-cover'
                />
            ) : (
                <span>{initials(job.company)}</span>
            )
        }
    </div>

    <div class='flex-1'>
        <h3 class='font-bold text-default'>
            {job.title} at {job.company}
        </h3>

        <p class='mt-2 text-[15px] text-soft'>{job.description}</p>
    </div>
</div>