---
import { Image } from 'astro:assets'
import { Navigation, Greeting, GreetingScript } from '@/components'
import { avatar } from '@/assets'
import { constants } from '@/config'

const { profile } = constants
---

<div data-reveal-group>
    <header class='mb-6 flex items-center justify-between'>
        <Image
            src={avatar}
            alt='Benjamin'
            width={96}
            height={96}
            class='h-24 w-24 select-none rounded-full'
            loading='eager'
            fetchpriority='high'
            data-skeleton
            draggable={false}
        />

        <slot />
    </header>

    <h1 class='mb-2 mt-4 text-4xl font-semibold leading-[1.2]'>
        <Greeting />, I'm Benjamin <span class='wave'>👋</span>
    </h1>

    <GreetingScript />

    <section class='mb-4 mt-2 space-y-2'>
        <h2 class='text-md font-normal leading-loose sm:leading-loose'>
            {profile.bio}
        </h2>
    </section>

    <div class='mt-8'>
        <Navigation />
    </div>
</div>