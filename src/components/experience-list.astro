---
import type { Experience } from '@/types'
import { ExperienceItem } from '@/components'

interface Props {
    items: Experience[]
}

const { items } = Astro.props
---

<section data-reveal>
    <h3 class='mb-3 font-semibold text-default'>Experience</h3>

    <div class='space-y-8' data-reveal-group>
        {items.map((job) => <ExperienceItem {...job} />)}
    </div>
</section>