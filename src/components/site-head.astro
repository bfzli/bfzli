---
import type { Props as PageProps } from '@/types'
import { ClientRouter } from 'astro:transitions'
import { constants } from '@/config'
import { cleanPath, markdownPath } from '@/utils/url'
import { isoDate } from '@/utils/date'

const { profile } = constants
const props = Astro.props as PageProps
const canonical = constants.site + cleanPath(Astro.url.pathname)
const markdown = constants.site + markdownPath(Astro.url.pathname)
---

<meta charset='utf-8' />
<meta
    name='theme-color'
    media='(prefers-color-scheme: light)'
    content='#fcfcfc'
/>
<meta
    name='theme-color'
    media='(prefers-color-scheme: dark)'
    content='#0a0a0b'
/>
<meta name='color-scheme' content='light dark' />

<meta name='viewport' content='width=device-width, initial-scale=1.0' />
<meta
    name='robots'
    content={props.noindex ? 'noindex,nofollow' : 'index,follow'}
/>
<meta
    name='googlebot'
    content={props.noindex ? 'noindex,nofollow' : 'index,follow'}
/>
<meta name='title' content={props.title} />
<meta name='description' content={props.description} />
<meta name='author' content={profile.name} />
<meta name='keywords' content={props.keywords} />
<meta property='og:locale' content='en' />
<meta property='og:site_name' content={profile.name} />
<meta property='og:title' content={props.title} />
<meta property='og:description' content={props.description} />
<meta property='og:image' content={constants.site + props.image} />
<meta property='og:image:alt' content={props.title} />
<meta property='og:image:type' content='image/png' />
<meta property='og:image:width' content='1200' />
<meta property='og:image:height' content='630' />
<meta property='og:type' content={props.type} />
<meta property='og:url' content={canonical} />
<meta name='twitter:card' content='summary_large_image' />
<meta name='twitter:creator' content={`@${profile.username}`} />
<meta name='twitter:site' content={`@${profile.username}`} />
<meta name='twitter:title' content={props.title} />
<meta name='twitter:description' content={props.description} />
<meta name='twitter:url' content={canonical} />
<meta name='twitter:image' content={constants.site + props.image} />
<meta name='twitter:image:alt' content={props.title} />

{
    props.date ? (
        <meta property='article:published_time' content={isoDate(props.date)} />
    ) : null
}

<link
    rel='preload'
    href='/fonts/onest/onest-latin-wght-normal.woff2'
    as='font'
    type='font/woff2'
    crossorigin
/>

<link rel='shortcut icon' type='image/ico' href='/favicon.ico' />
<link rel='sitemap' href='/sitemap-index.xml' />
<link rel='canonical' href={canonical} />
<link
    rel='alternate'
    type='application/rss+xml'
    title={profile.name}
    href={`${constants.site}/rss.xml`}
/>
{
    props.noindex ? null : (
        <link
            rel='alternate'
            type='text/markdown'
            title={`${props.title} (Markdown)`}
            href={markdown}
        />
    )
}

<title>
    {props.title}
</title>

<script
    type='application/ld+json'
    set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
            {
                '@type': 'WebSite',
                '@id': `${constants.site}/#website`,
                name: profile.name,
                url: constants.site,
                publisher: { '@id': `${constants.site}/#person` }
            },
            {
                '@type': 'Person',
                '@id': `${constants.site}/#person`,
                name: profile.name,
                url: constants.site,
                jobTitle: 'Principal Engineer',
                sameAs: [
                    profile.links.github,
                    profile.links.linkedIn,
                    profile.links.twitter
                ]
            }
        ]
    })}
/>

<ClientRouter />