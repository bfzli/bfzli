---
import { constants } from '@/config'
---

<footer
    class='mt-32 flex flex-col-reverse items-center justify-between gap-8 p-2 text-sm md:flex-row md:gap-32'
>
    <span class='text-soft'>
        {new Date().getFullYear()} &copy; All rights reserved.
    </span>

    <nav class='flex items-center'>
        <ul class='flex flex-wrap justify-center gap-4 sm:gap-8'>
            {
                constants.links.external.map(({ name, link }) => (
                    <li class='transition-hover text-muted hover:text-default'>
                        <a href={link}>{name}</a>
                    </li>
                ))
            }
            <li class='transition-hover text-muted hover:text-default'>
                <a href='/rss.xml'>RSS</a>
            </li>
        </ul>
    </nav>
</footer>